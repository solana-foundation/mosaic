{
    "name": "@mosaic/app",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint src",
        "type-check": "tsc --noEmit",
        "smoke-test": "node scripts/smoke-test.mjs"
