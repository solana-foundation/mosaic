# NOTE: NEXT_PUBLIC_* values are inlined at build time. Changing either variable
# below requires a rebuild/redeploy, not just a server restart.

# Default Solana network
# The cluster the app boots into when the user has never picked one.
# If not set, defaults to devnet.
# A user's explicit in-app network choice is persisted and takes precedence over
# this on their next visit - this sets the default, it is not a hard override.
# Accepted values: devnet | testnet | mainnet-beta ("mainnet" is accepted as an alias)
NEXT_PUBLIC_SOLANA_NETWORK=

# Solana RPC URL
# Set this to use a custom Solana RPC endpoint (e.g., Helius, QuickNode, or your own node)
# This URL is attached to the cluster of NEXT_PUBLIC_SOLANA_NETWORK (devnet by
# default), so a paid mainnet endpoint also needs NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta.
# next build / next dev check the endpoint's genesis hash and fail if it serves
# a different public cluster than that network.
# If not set, each cluster uses its public endpoint.
# This variable is exposed to the client-side, so any API key in it is public.
# Example values:
#   - Devnet: https://api.devnet.solana.com
#   - Testnet: https://api.testnet.solana.com
#   - Mainnet: https://api.mainnet-beta.solana.com
#   - Custom RPC: https://your-rpc-endpoint.com
NEXT_PUBLIC_SOLANA_RPC_URL=
