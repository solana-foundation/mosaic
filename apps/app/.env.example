# NOTE: NEXT_PUBLIC_* values are inlined at build time. Changing any variable
# below requires a rebuild/redeploy, not just a server restart.

# Default Solana network
# The cluster the app boots into when the user has never picked one.
# If not set, defaults to devnet.
# A user's explicit in-app network choice is persisted and takes precedence over
# this on their next visit - this sets the default, it is not a hard override.
# Accepted values: devnet | testnet | mainnet-beta ("mainnet" is accepted as an alias)
NEXT_PUBLIC_SOLANA_NETWORK=

# Solana RPC URLs, one per network
#
# Each variable replaces the public endpoint of its own network only, and the
# network's entry in the cluster switcher is labelled "(Env RPC)". Leave a
# variable unset to use that network's public endpoint. The public endpoints are
# heavily rate-limited and may reject browser writes with HTTP 403, so point the
# networks you actually test against at a provider (Helius, QuickNode, Triton).
# Confidential transfers in particular need a devnet provider endpoint.
#
# They are separate on purpose: one URL shared by every network would put a
# mainnet endpoint behind the "Devnet" entry, where test actions move real funds.
#
# Exposed to the client and inlined at build time, so a production build must be
# rebuilt after changing them.

# Mainnet. Defaults to https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=
# Devnet. Defaults to https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=
# Testnet. Defaults to https://api.testnet.solana.com
NEXT_PUBLIC_SOLANA_TESTNET_RPC_URL=
